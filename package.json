{
  "name": "tce-go-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "lint": "tsc --noEmit && node scripts/lint-content.mjs",
    "audit": "npm audit --audit-level=high",
    "validate:snapshot": "node scripts/validate-tce-go-snapshot.mjs",
    "build": "node scripts/build-github-pages.mjs",
    "test": "node --test tests/*.test.mjs",
    "quality": "npm run lint && npm run audit && npm run validate:snapshot && npm run build && npm test"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
